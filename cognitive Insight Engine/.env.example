# Google AI Studio free-tier key. Keep this server-side; never expose it in frontend code.
GEMINI_API_KEY=

# Keep the model already tested with your account. Change only if your AI Studio project
# confirms another model is available to it. This backend uses no paid-only tools.
GEMINI_MODEL=gemini-3.8-flash

# Lowest supported thinking effort for this model. Lower reasoning reduces latency.
GEMINI_THINKING_LEVEL=low

# Free-tier-friendly planning ceiling. Eight tasks usually covers a hackathon MVP.
GEMINI_MAX_TASKS=8
GEMINI_MAX_OUTPUT_TOKENS=3072

# Repeated identical project/team inputs reuse the successful plan for 15 minutes.
# Cache is in-memory and clears whenever this service restarts. Set 0 to disable.
GEMINI_CACHE_TTL_SECONDS=900

PORT=8787
CORS_ORIGINS=
GEMINI_REQUIRED=false
