# MongoDB connection string. Local: mongodb://127.0.0.1:27017/cogniflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cogniflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cogniflow

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000
# Browser origin(s) allowed to call the API (comma separated). Needed when the frontend is on another origin.
CLIENT_ORIGIN=http://localhost:5173
# The Python AI recommender (kept server-side so its URL/key never reach the browser)
AI_SERVICE_URL=http://localhost:8787
NODE_ENV=development
